{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Test Design workflow state",
  "description": "test-design/state/workflow.json: checkpoint for one run. Contains no secret values.",
  "type": "object",
  "required": ["version", "runId", "status", "projectRoot", "sourceFiles", "currentPhase", "stories", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "runId": { "type": "string", "pattern": "^run-[0-9]{8}-[0-9]{6}$" },
    "status": { "type": "string", "enum": ["in_progress", "awaiting_user", "completed", "completed_with_warnings", "failed"] },
    "projectRoot": { "type": "string", "minLength": 1 },
    "sourceFiles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "currentPhase": { "type": "string", "enum": ["discover", "analyse", "design", "generate", "validate", "save", "finalise", "done"] },
    "currentStoryId": { "type": ["string", "null"] },
    "stories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": ["pending", "analysing", "designing", "generating", "validating", "saved", "skipped", "needs_clarification", "failed"]
          },
          "sourceFile": { "type": "string" },
          "testCaseIds": { "type": "array", "items": { "type": "string" } },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": { "type": "string", "enum": ["not_run", "passed", "passed_with_warnings", "failed"] },
              "errors": { "type": "integer", "minimum": 0 },
              "warnings": { "type": "integer", "minimum": 0 },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["code", "severity", "message"],
                  "additionalProperties": false,
                  "properties": {
                    "code": { "type": "string" },
                    "severity": { "type": "string", "enum": ["error", "warning"] },
                    "message": { "type": "string" },
                    "caseId": { "type": "string" }
                  }
                }
              }
            }
          },
          "clarification": { "type": ["string", "null"] },
          "updatedAt": { "type": "string" }
        }
      }
    },
    "lastCompletedOperation": {
      "type": ["object", "null"],
      "required": ["name", "completedAt"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "storyId": { "type": ["string", "null"] },
        "completedAt": { "type": "string" }
      }
    },
    "inProgressOperation": {
      "type": ["object", "null"],
      "required": ["name", "startedAt"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "storyId": { "type": ["string", "null"] },
        "startedAt": { "type": "string" }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "testCases": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string" },
            "caseCount": { "type": "integer", "minimum": 0 },
            "updatedAt": { "type": "string" }
          }
        },
        "traceability": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "path": { "type": "string" }, "sha256": { "type": "string" } }
        },
        "fingerprints": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "path": { "type": "string" }, "sha256": { "type": "string" } }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "path": { "type": "string" } }
        }
      }
    },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  }
}
